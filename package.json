{
	"name": "endia",
	"version": "0.0.3",
	"description": "Client for EastIndia, which runs Windows desktop test machines that tests drive like Docker containers. Early preview.",
	"license": "MIT",
	"author": "teaToolkit",
	"private": false,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint --max-warnings 0 .",
		"check": "tsc -p tsconfig.json && eslint --max-warnings 0 .",
		"test": "npm run check && node --test --test-reporter=spec \"build/test/unit/**/*.test.js\" \"build/test/integration/**/*.test.js\"",
		"test:live": "npm run check && node --test --test-reporter=spec --test-concurrency=1 \"build/test/live/**/*.test.js\"",
		"prepack": "npm run build"
	},
	"dependencies": {
		"tar": "7.5.22",
		"ws": "8.22.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "20.19.43",
		"@types/ws": "8.18.2",
		"eslint": "10.14.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	}
}
